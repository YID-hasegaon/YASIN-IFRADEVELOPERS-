function del(cat,id){if(!confirm('Delete?'))return;d[cat]=d[cat].filter(x=>x.id!=id);localStorage.setItem('yasin_final_v12',JSON.stringify(d));render();}
function calcBaki(n){let l=0,dd=0;d.worker.filter(x=>x.name.toLowerCase()==n.toLowerCase()).forEach(x=>{x.type=='Liya'||x.type=='Advance'?l+=x.amount:dd+=x.amount});return{baki:l-dd};}
function render(){let wh='<table><tr><th>Naam</th><th>Cat</th><th>Type</th><th>Rs</th><th>Baki</th><th>X</th></tr>';d.worker.slice().reverse().forEach(r=>{let b=calcBaki(r.name);wh+=`<tr><td>${r.name}</td><td><small>${r.cat}</small></td><td>${r.type}</td><td>${r.amount}</td><td style="color:${b.baki>=0?'green':'red'};font-weight:bold">${b.baki}</td><td><button onclick="del('worker',${r.id})" style="background:red;color:white;border:none;border-radius:4px">X</button></td></tr>`});wh+='</table>';document.getElementById('wList').innerHTML=wh;let ph='<table><tr><th>Party</th><th>Type</th><th>Rs</th><th>X</th></tr>';d.party.slice().reverse().forEach(r=>{ph+=`<tr><td>${r.name}</td><td>${r.type}</td><td>${r.amount}</td><td><button onclick="del('party',${r.id})" style="background:red;color:white;border:none">X</button></td></tr>`});ph+='</table>';document.getElementById('pList').innerHTML=ph;let j=0,k=0;d.party.forEach(x=>{x.type=='Jama'?j+=x.amount:k+=x.amount});document.getElementById('pTotal').innerText=`Jama: ₹${j.toLocaleString('en-IN')} | Kharch: ₹${k.toLocaleString('en-IN')} | Baki: ₹${(j-k).toLocaleString('en-IN')}`;}
calcBill();calcCustom();render();
</script>
